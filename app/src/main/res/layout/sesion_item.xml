<?xml version="1.0" encoding="utf-8"?>
<!-- Vista personalizada de cada ítem del RecyclerView, SIN CardView.
     ConstraintLayout: cada texto se amarra al de arriba, así los 5 quedan unidos. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/blanco"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <TextView
        android:id="@+id/txtItemTipo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Fuerza"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/rosa"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtItemIntensidad"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Intensidad: Media"
        android:textColor="@color/texto"
        app:layout_constraintTop_toBottomOf="@id/txtItemTipo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtItemDuracion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Duración: 30 min"
        android:textColor="@color/texto"
        app:layout_constraintTop_toBottomOf="@id/txtItemIntensidad"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtItemEsfuerzo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Esfuerzo: 3/5"
        android:textColor="@color/texto"
        app:layout_constraintTop_toBottomOf="@id/txtItemDuracion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtItemAspectos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Completado: Calentamiento"
        android:textColor="@color/texto"
        app:layout_constraintTop_toBottomOf="@id/txtItemEsfuerzo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
